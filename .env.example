# Postgres connection string. Anything Postgres works: a local server, a
# container, or a hosted one (Neon, Vercel Postgres, Supabase).
#   local:  postgresql://monk@127.0.0.1:5432/monk
#   hosted: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://monk@127.0.0.1:5432/monk"

# Catalog source for the ingestion script (step 3). Nothing is crawled until
# that script exists and the site's robots.txt/terms have been checked.
INGEST_BASE_URL="https://seslikitab.org"

# Sent with every ingestion request so the source site can identify the crawler.
INGEST_USER_AGENT="MONK/0.1 (+https://github.com/nuriyevgoshgar/monk)"

# Politeness delay between ingestion requests, in milliseconds. Keep >= 1000.
# Raised automatically if robots.txt asks for a longer Crawl-delay.
INGEST_DELAY_MS="1000"

# Catalogue page the crawl starts from.
INGEST_CATALOG_PATH="/"

# Which URL paths count as a book page. Tune this here rather than in code —
# the default is a guess, since the site could not be reached to check.
INGEST_BOOK_URL_PATTERN="/(kitap|book|audiobook)/[^/]+/?$"
